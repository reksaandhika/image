{
  "private": true,
  "name": "image",
  "version": "2.0.0",
  "license": "apache-2.0",
  "contributors": [
    "Reksa Andhika"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
